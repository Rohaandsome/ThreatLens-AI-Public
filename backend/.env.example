# ThreatLens AI — backend environment template.
# Copy to backend/.env and fill in values. Never commit a real backend/.env file.
# See backend/app/config.py for the authoritative defaults.
#
#   cp backend/.env.example backend/.env
#   # Generate operator/admin keys with:
#   # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Secrets — leave empty until configured (fail closed).
MODEL_API_KEY=
OPERATOR_API_KEY=
ADMIN_API_KEY=
MISP_URL=
MISP_API_KEY=

# General (defaults match config.py).
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Meta Model API (OpenAI-compatible).
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_TOKENS=16000

# Upload + analysis limits.
MAX_UPLOAD_BYTES=10485760
MAX_REPORT_CHARS=60000

# MISP integration (optional). Destination allowlist fails closed:
# org-only distribution, no sharing groups until explicitly listed.
MISP_VERIFY_SSL=true
MISP_TIMEOUT_SECONDS=30
MISP_ALLOWED_DISTRIBUTIONS=0
MISP_ALLOWED_SHARING_GROUPS=

# Operator sessions.
SESSION_TIMEOUT_SECONDS=43200
